# --- Core ---------------------------------------------------------------
# Neon (or any Postgres) connection string.
DATABASE_URL=postgres://patchai:patchai@localhost:5432/patchai
# Public base URL of this app, used for OAuth/Stripe/GitHub redirects.
APP_URL=http://localhost:3000
# `npx auth secret` generates one.
AUTH_SECRET=
# Email-only login for local development and tests. Ignored on Vercel production.
AUTH_DEV_LOGIN=false
# Comma-separated emails that can open /admin (kill switch, abuse reports).
PLATFORM_ADMIN_EMAILS=

# --- GitHub App ---------------------------------------------------------
# Use the GitHub App's own OAuth client ID/secret for sign-in so the user token
# can list the installations the user may link (GET /user/installations).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key; literal "\n" sequences are converted to newlines.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# --- Stripe -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Enable once Stripe Tax is configured for your account.
STRIPE_AUTOMATIC_TAX=false

# --- Operations ---------------------------------------------------------
# Set to "true" to stop all new scans immediately (also stops running ones in the worker).
PATCHAI_KILL_SWITCH=false
# Published scanner egress IPs, shown on /security so customers can allowlist them.
SCANNER_EGRESS_IPS=
ABUSE_CONTACT_EMAIL=abuse@patch.ai
# Shown on /security and in /.well-known/security.txt; falls back to ABUSE_CONTACT_EMAIL.
SECURITY_CONTACT_EMAIL=security@patch.ai
